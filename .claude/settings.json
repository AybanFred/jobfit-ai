{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(npx vue-tsc *)",
      "Bash(npx cap sync *)",
      "Bash(.venv/Scripts/python -m pytest)",
      "Bash(.venv/Scripts/python -m pytest *)",
      "Bash(.venv/Scripts/python -m pip install *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git checkout -- *)",
      "Bash(rm *)"
    ],
    "deny": [
      "Read(.env)",
      "Edit(.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
