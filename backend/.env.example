# Copy this file to .env and fill in your values.
# Supabase Dashboard → Project Settings → API (and → JWT Keys)

APP_ENV=development
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret / service_role key — server only, NEVER put this in the mobile app
SUPABASE_SERVICE_KEY=your-secret-or-service-role-key
# Only needed if your project still uses the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:8100,http://localhost:5173,capacitor://localhost,http://localhost

# Reserved for Phase 3 (not used by resume import)
ANTHROPIC_API_KEY=

# Free-tier AI providers for resume import. Leave a key empty to hide that provider.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Models users can pick per provider (comma-separated). Edit here if a model is renamed.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
OPENAI_MODELS=gpt-4o-mini
