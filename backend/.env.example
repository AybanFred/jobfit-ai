# Copy this file to .env and fill in your values.
# Supabase Dashboard → Project Settings → API (and → JWT Keys)

APP_ENV=development
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Secret / service_role key — server only, NEVER put this in the mobile app
SUPABASE_SERVICE_KEY=your-secret-or-service-role-key
# Only needed if your project still uses the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:8100,http://localhost:5173,capacitor://localhost,http://localhost

# AI provider (used from Phase 3)
ANTHROPIC_API_KEY=
