# Copy to .env in your Ionic project root.
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable / anon key ONLY (safe for the app). Never the secret/service key.
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# FastAPI backend. On an Android emulator use http://10.0.2.2:8000
# On a real phone use your computer's LAN IP, e.g. http://192.168.1.10:8000
VITE_API_URL=http://localhost:8000/api/v1
